{
  "name": "basetemplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:node",
    "lint": "oxlint",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "deploy": "bash deploy/deploy.sh up"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ead/antd-style": "^4.1.1",
    "@ead/suid": "^2.1.99",
    "@ead/suid-icons": "^1.2.16",
    "ahooks": "^3.11.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "msw": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
